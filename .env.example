# Payload
PAYLOAD_SECRET=
# Supabase Postgres connection string (pooler). Payload keeps its tables in the "payload" schema.
DATABASE_URL=

# Supabase Storage via S3 API (Project Settings > Storage > S3 Connection)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=project-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# e.g. https://<project-ref>.supabase.co/storage/v1/object/public/project-images
S3_PUBLIC_URL=
